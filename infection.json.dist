{
  "timeout": 60,
  "source": {
    "directories": [
      "src/Access",
      "src/Cache",
      "src/Command",
      "src/Config",
      "src/Controller",
      "src/Database",
      "src/File",
      "src/Form",
      "src/Object",
      "src/ObjectMembership",
      "src/Setup",
      "src/User",
      "src/UserGroup",
      "src/Util",
      "src/Widget"
    ],
    "excludes": [
      "vendor",
      "tests"
    ]
  },
  "testFramework": "phpunit",
  "bootstrap": "./tests/bootstrap.php",
  "logs": {
    "text": "infection.txt",
    "json": "infection.json"
  },
  "mutators": {
    "@default": true,
    "@cast": false,
    "@function_signature": false,
    "MethodCallRemoval": {
      "ignore": [
        "UserAccessManager\\Command\\GroupCommand::__construct",
        "UserAccessManager\\Command\\ObjectCommand::__construct"
      ]
    },
    "UnwrapRtrim": {
      "ignore": [
        "UserAccessManager\\Controller\\Backend\\Administration\\AboutController::getAllSupporters"
      ]
    },
    "IncrementInteger": {
      "ignore": [
        "UserAccessManager\\Controller\\Backend\\ObjectMembership\\ObjectController::sortUserGroups"
      ]
    },
    "DecrementInteger": {
      "ignore": [
        "UserAccessManager\\Controller\\Backend\\ObjectMembership\\ObjectController::sortUserGroups",
        "UserAccessManager\\User\\UserHandler::checkUserAccess"
      ]
    },
    "InstanceOf_": {
      "ignore": [
        "UserAccessManager\\User\\UserHandler::getUserRole"
      ]
    },
    "LogicalAnd": {
      "ignore": [
        "UserAccessManager\\User\\UserHandler::getUserRole"
      ]
    },
    "Break_": {
      "ignore": [
        "UserAccessManager\\Controller\\Frontend\\Content\\TermController::updateTermParent"
      ]
    },
    "ArrayOneItem": {
      "ignore": [
        "UserAccessManager\\File\\FileHandler::getExtraContents",
        "UserAccessManager\\ObjectMembership\\ObjectMembershipWithMapHandler::getRecursiveMembershipByMap"
      ]
    },
    "UnwrapArrayFilter": {
      "ignore": [
        "UserAccessManager\\Access\\AccessHandler::getExcludedPosts"
      ]
    },
    "NullSafePropertyCall": {
      "ignore": [
        "UserAccessManager\\Controller\\Frontend\\Content\\PostController::getRestBaseToPostTypeMap"
      ]
    },
    "Coalesce": {
      "ignore": [
        "UserAccessManager\\Controller\\Frontend\\RedirectController::extractObjectTypeAndId",
        "UserAccessManager\\Cache\\Cache::setActiveCacheProvider",
        "UserAccessManager\\Form\\FormHelper::getSettingsForm",
        "UserAccessManager\\Controller\\Frontend\\Content\\PostController::getRestRouteTarget",
        "UserAccessManager\\Cache\\Cache::getFromRuntimeCache",
        "UserAccessManager\\Config\\MainConfig::getObjectParameter",
        "UserAccessManager\\Controller\\Backend\\Administration\\SettingsController::getObjectName",
        "UserAccessManager\\Controller\\Backend\\Administration\\SettingsController::updateFileProtectionFile",
        "UserAccessManager\\Form\\FormHelper::getPublicObject",
        "UserAccessManager\\Form\\FormHelper::convertSelectionParameter",
        "UserAccessManager\\Object\\ObjectHandler::getGeneralObjectType",
        "UserAccessManager\\ObjectMembership\\Type\\PostMembershipHandler::getFullObjects",
        "UserAccessManager\\UserGroup\\AbstractUserGroup::isObjectAssignedToGroup"
      ]
    },
    "UnwrapUcFirst": {
      "ignore": [
        "UserAccessManager\\Controller\\Backend\\Administration\\UserGroupController::getUserGroups"
      ]
    },
    "FunctionCallRemoval": {
      "ignore": [
        "UserAccessManager\\Controller\\BaseControllerTrait::getIncludeContents"
      ]
    },
    "UnwrapArrayMap": {
      "ignore": [
        "UserAccessManager\\Controller\\Controller::processAction"
      ]
    },
    "UnwrapStrReplace": {
      "ignore": [
        "UserAccessManager\\Controller\\Frontend\\RedirectController::normalizeAttachmentUrl"
      ]
    }
  },
  "minMsi": 98,
  "minCoveredMsi": 98
}